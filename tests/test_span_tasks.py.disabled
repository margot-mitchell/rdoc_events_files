    def test_opspan_expansion_rules(self):
        """
        Test that opSpan event files follow the specific expansion rules:
        
        1. For each row in dropbox_bids input where moving_through_grid_timestamps is not empty, 
           there is a separate row for each item in that list (in the same order)
        2. Each of those rows has the corresponding cell_order_through_grid item at the same index
        3. For non-empty valid_responses_timestamps, duplicate_responses_timestamps, 
           and extra_responses_timestamps, the output has a row for each item in those lists
        4. Items in correct_navigation_response and valid_responses_timestamps lists with matching 
           indexes should be in the same row in the output (correct_nav[i] with valid_responses[i])
           For uneven lengths, correct_navigation_response should be longer and response_time should be n/a
        
        This test will fail until the processing logic is implemented.
        """
        import ast
        from pathlib import Path
        
        # Find opSpan input files in dropbox_bids
        input_dir = Path("dropbox_bids")
        opspan_input_files = list(input_dir.glob("**/**/*operation_span*_rdoc__fmri.csv"))
        
        if not opspan_input_files:
            pytest.skip("No operation_span input files found in dropbox_bids")
        
        # Find corresponding output event files
        output_dir = Path("output")
        opspan_output_files = list(output_dir.glob("**/**/*opSpan*_events.tsv"))
        
        if not opspan_output_files:
            pytest.skip("No operation_span output event files found in output directory")
        
        # Test one file pair to start
        input_file = opspan_input_files[0]
        output_file = opspan_output_files[0]
        
        # Read the files
        input_df = pd.read_csv(input_file)
        output_df = pd.read_csv(output_file, sep='\t')
        
        # Parse list columns from input to understand expected expansion
        total_expected_rows = 0
        navigation_response_mappings = []  # Store mappings for rule 4
        
        for idx, row in input_df.iterrows():
            moving_timestamps_str = row.get('moving_through_grid_timestamps', '')
            cell_order_str = row.get('cell_order_through_grid', '')
            valid_responses_str = row.get('valid_responses_timestamps', '')
            duplicate_responses_str = row.get('duplicate_responses_timestamps', '')
            extra_responses_str = row.get('extra_responses_timestamps', '')
            correct_navigation_str = row.get('correct_navigation_response', '')
            
            # Parse the lists
            def parse_list(list_str):
                if pd.isna(list_str) or list_str == '' or list_str == 'n/a':
                    return []
                try:
                    return ast.literal_eval(list_str) if isinstance(list_str, str) else []
                except:
                    return []
            
            moving_timestamps = parse_list(moving_timestamps_str)
            cell_order = parse_list(cell_order_str)
            valid_responses = parse_list(valid_responses_str)
            duplicate_responses = parse_list(duplicate_responses_str)
            extra_responses = parse_list(extra_responses_str)
            correct_navigation = parse_list(correct_navigation_str)
            
            # Rule 4: Check correct_navigation_response and valid_responses_timestamps alignment
            if correct_navigation and valid_responses:
                # Store the mapping for later verification
                navigation_response_mappings.append({
                    'trial_id': row.get('trial_id', f'trial_{idx}'),
                    'correct_navigation': correct_navigation,
                    'valid_responses': valid_responses,
                    'input_row_idx': idx
                })
            
            # Count expected rows for this input row
            expected_rows = 0
            
            # Rule 1 & 2: moving_through_grid_timestamps expansion
            if moving_timestamps:
                expected_rows += len(moving_timestamps)
            
            # Rule 3: Additional response timestamps
            if valid_responses:
                expected_rows += len(valid_responses)
            if duplicate_responses:
                expected_rows += len(duplicate_responses)
            if extra_responses:
                expected_rows += len(extra_responses)
            
            # If no list data, should have at least 1 row
            if expected_rows == 0:
                expected_rows = 1
                
            total_expected_rows += expected_rows
        
        # For now, just check that we have a reasonable number of output rows
        # The exact logic will be refined once the processing is implemented
        assert len(output_df) > 0, "Output should have at least one row"
        
        # This assertion will likely fail until the processing logic is implemented
        # assert len(output_df) == total_expected_rows, f"Expected {total_expected_rows} rows but got {len(output_df)}"
        
        # Rule 4: Verify correct_navigation_response and valid_responses_timestamps alignment
        for mapping in navigation_response_mappings:
            trial_id = mapping['trial_id']
            correct_navigation = mapping['correct_navigation']
            valid_responses = mapping['valid_responses']
            
            # Find output rows for this trial
            trial_rows = output_df[output_df.get('trial_id', '').str.contains(str(trial_id), na=False)]
            
            if len(trial_rows) == 0:
                # Try alternative matching strategies
                trial_rows = output_df[output_df.index == mapping['input_row_idx']]
            
            # Check that each correct_navigation item has corresponding valid_responses item
            for i, correct_nav_item in enumerate(correct_navigation):
                # Find row with this correct_navigation item
                nav_rows = trial_rows[trial_rows.get('correct_navigation_response', '') == str(correct_nav_item)]
                
                if len(nav_rows) == 0:
                    # Try finding by index if direct matching doesn't work
                    if i < len(trial_rows):
                        nav_rows = trial_rows.iloc[[i]]
                
                assert len(nav_rows) > 0, f"Could not find output row for correct_navigation_response {correct_nav_item} in trial {trial_id}"
                
                # Get the response_time for this row
                nav_row = nav_rows.iloc[0]
                response_time = nav_row.get('response_time', nav_row.get('valid_responses_timestamps', ''))
                
                if i < len(valid_responses):
                    # Should have corresponding valid_responses timestamp
                    expected_time = str(valid_responses[i])
                    assert response_time == expected_time, f"For correct_navigation_response {correct_nav_item}, expected response_time {expected_time} but got {response_time}"
                else:
                    # Should be n/a since valid_responses list is shorter
                    assert response_time == 'n/a' or response_time == '', f"For correct_navigation_response {correct_nav_item}, expected response_time to be n/a but got {response_time}"
        
        # TODO: Add more specific assertions once processing logic is implemented
        # - Check that moving_timestamps items appear in separate rows
        # - Check that cell_order items are correctly aligned  
        # - Check that response timestamps appear in separate rows

    def test_span_timestamps_appear_in_response_time(self):
        """
        Test that all timestamp values from input lists appear in response_time column of output.
        
        For both opSpan and simpleSpan, verify that every timestamp from:
        - moving_through_grid_timestamps
        - valid_responses_timestamps  
        - extra_responses_timestamps
        - duplicate_responses_timestamps
        
        appears as a value in the response_time column of the output file.
        """
        import ast
        from pathlib import Path
        
        # Find span input files in dropbox_bids
        input_dir = Path("dropbox_bids")
        span_input_files = list(input_dir.glob("**/*span*_rdoc__fmri.csv"))
        
        if not span_input_files:
            pytest.skip("No span input files found in dropbox_bids")
        
        # Find corresponding output event files
        output_dir = Path("output")
        span_output_files = list(output_dir.glob("**/*Span*_events.tsv"))
        
        if not span_output_files:
            pytest.skip("No span output event files found in output directory")
        
        # Test each file pair
        for input_file in span_input_files:
            # Find corresponding output file
            subject = input_file.stem.split('_')[0]  # e.g., "sub-s4"
            session = input_file.stem.split('_')[1]  # e.g., "ses-1" 
            run = input_file.stem.split('_')[2]      # e.g., "run-1"
            
            matching_output = None
            for output_file in span_output_files:
                if subject in output_file.name and session in output_file.name and run in output_file.name:
                    matching_output = output_file
                    break
            
            if not matching_output:
                continue
                
            # Read the files
            input_df = pd.read_csv(input_file)
            output_df = pd.read_csv(matching_output, sep='\t')
            
            # Collect all expected timestamps from input
            all_expected_timestamps = []
            
            for idx, row in input_df.iterrows():
                # Parse the list columns
                def parse_list(list_str):
                    if pd.isna(list_str) or list_str == '' or list_str == 'n/a':
                        return []
                    try:
                        return ast.literal_eval(list_str) if isinstance(list_str, str) else []
                    except:
                        return []
                
                moving_timestamps = parse_list(row.get('moving_through_grid_timestamps', ''))
                valid_responses = parse_list(row.get('valid_responses_timestamps', ''))
                extra_responses = parse_list(row.get('extra_responses_timestamps', ''))
                duplicate_responses = parse_list(row.get('duplicate_responses_timestamps', ''))
                
                # Add all timestamps to the expected list
                all_expected_timestamps.extend([str(t) for t in moving_timestamps])
                all_expected_timestamps.extend([str(t) for t in valid_responses])
                all_expected_timestamps.extend([str(t) for t in extra_responses])
                all_expected_timestamps.extend([str(t) for t in duplicate_responses])
            
            # Remove duplicates and empty strings
            all_expected_timestamps = list(set([t for t in all_expected_timestamps if t.strip()]))
            
            if not all_expected_timestamps:
                # No timestamp lists found in input, skip this file
                continue
            
            # Get all response_time values from output
            response_times = output_df['response_time'].astype(str).tolist()
            # Remove 'n/a' and empty values
            response_times = [t for t in response_times if t not in ['n/a', '', 'nan']]
            
            # Check that every expected timestamp appears in response_time
            missing_timestamps = []
            for expected_timestamp in all_expected_timestamps:
                if expected_timestamp not in response_times:
                    missing_timestamps.append(expected_timestamp)
            
            if missing_timestamps:
                pytest.fail(
                    f"Input file {input_file.name} has timestamps that don't appear in response_time column:\n"
                    f"Missing timestamps: {missing_timestamps}\n"
                    f"Expected timestamps: {all_expected_timestamps}\n"
                    f"Found response_times: {response_times}"
                )

    def test_opspan_required_columns(self):
        """
        Test that opSpan TSV output files have all required columns:
        onset, trial_id, trial_type, response_time, key_press, acc, spatial_response, 
        grid_response, grid_movement, correct_response, grid_symmetry, starting_cell
        """
        from pathlib import Path
        
        # Find opSpan output event files
        output_dir = Path("output")
        opspan_output_files = list(output_dir.glob("**/**/*opSpan*_events.tsv"))
        
        if not opspan_output_files:
            pytest.skip("No operation_span output event files found in output directory")
        
        # Required columns for opSpan
        required_columns = [
            'onset',
            'trial_id', 
            'trial_type',
            'response_time',
            'key_press',
            'acc',
            'spatial_response',
            'grid_response', 
            'grid_movement',
            'correct_response',
            'grid_symmetry',
            'spatial_location',
            'starting_cell'
        ]
        
        missing_columns_files = []
        
        for file_path in opspan_output_files:
            df = pd.read_csv(file_path, sep='\t')
            missing_columns = [col for col in required_columns if col not in df.columns]
            
            if missing_columns:
                missing_columns_files.append({
                    'file': str(file_path),
                    'missing_columns': missing_columns
                })
        
        if missing_columns_files:
            error_msg = "operation_span event files missing required columns:\n"
            for file_info in missing_columns_files:
                error_msg += f"  {file_info['file']}: missing {file_info['missing_columns']}\n"
            error_msg += f"\nAll operation_span event files must have: {required_columns}"
            pytest.fail(error_msg)

    def test_opspan_grid_response_mapping(self):
        """
        Test that every timestamp from valid_responses, extra_responses, and duplicate_responses
        in the input appears as a value in the grid_response column of the opSpan TSV output.
        """
        import ast
        from pathlib import Path
        
        # Find opSpan input files in dropbox_bids
        input_dir = Path("dropbox_bids")
        opspan_input_files = list(input_dir.glob("**/**/*operation_span*_rdoc__fmri.csv"))
        
        if not opspan_input_files:
            pytest.skip("No operation_span input files found in dropbox_bids")
        
        # Find corresponding output event files
        output_dir = Path("output")
        opspan_output_files = list(output_dir.glob("**/**/*opSpan*_events.tsv"))
        
        if not opspan_output_files:
            pytest.skip("No operation_span output event files found in output directory")
        
        # Test each file pair
        for input_file in opspan_input_files:
            # Find corresponding output file
            subject = input_file.stem.split('_')[0]  # e.g., "sub-s4"
            session = input_file.stem.split('_')[1]  # e.g., "ses-1" 
            run = input_file.stem.split('_')[2]      # e.g., "run-1"
            
            matching_output = None
            for output_file in opspan_output_files:
                if subject in output_file.name and session in output_file.name and run in output_file.name:
                    matching_output = output_file
                    break
            
            if not matching_output:
                continue
                
            # Read the files
            input_df = pd.read_csv(input_file)
            output_df = pd.read_csv(matching_output, sep='\t')
            
            # Collect all expected timestamps from input
            all_expected_timestamps = []
            
            for idx, row in input_df.iterrows():
                # Parse the response timestamp lists
                def parse_list(list_str):
                    if pd.isna(list_str) or list_str == '' or list_str == 'n/a':
                        return []
                    try:
                        return ast.literal_eval(list_str) if isinstance(list_str, str) else []
                    except:
                        return []
                
                valid_responses = parse_list(row.get('valid_responses_timestamps', ''))
                extra_responses = parse_list(row.get('extra_responses_timestamps', ''))
                duplicate_responses = parse_list(row.get('duplicate_responses_timestamps', ''))
                
                # Add all response timestamps to the expected list
                all_expected_timestamps.extend([str(t) for t in valid_responses])
                all_expected_timestamps.extend([str(t) for t in extra_responses])
                all_expected_timestamps.extend([str(t) for t in duplicate_responses])
            
            # Remove duplicates and empty strings
            all_expected_timestamps = list(set([t for t in all_expected_timestamps if t.strip()]))
            
            if not all_expected_timestamps:
                # No response timestamp lists found in input, skip this file
                continue
            
            # Get all grid_response values from output
            grid_responses = output_df['grid_response'].astype(str).tolist()
            # Remove 'n/a' and empty values
            grid_responses = [t for t in grid_responses if t not in ['n/a', '', 'nan']]
            
            # Check that every expected timestamp appears in grid_response
            missing_timestamps = []
            for expected_timestamp in all_expected_timestamps:
                if expected_timestamp not in grid_responses:
                    missing_timestamps.append(expected_timestamp)
            
            if missing_timestamps:
                pytest.fail(
                    f"Input file {input_file.name} has response timestamps that don't appear in grid_response column:\n"
                    f"Missing timestamps: {missing_timestamps}\n"
                    f"Expected timestamps: {all_expected_timestamps}\n"
                    f"Found grid_responses: {grid_responses}"
                )

    def test_span_correct_cell_order_alignment(self):
        """
        Test that for each row in input where correct_cell_order is not empty,
        the items in the correct_cell_order column list and the items in 
        valid_responses_timestamps with the same index are in the same row in the output TSV.
        
        This tests both opSpan and simpleSpan tasks.
        """
        import ast
        from pathlib import Path
        
        # Find span input files in dropbox_bids
        input_dir = Path("dropbox_bids")
        span_input_files = list(input_dir.glob("**/*span*_rdoc__fmri.csv"))
        
        if not span_input_files:
            pytest.skip("No span input files found in dropbox_bids")
        
        # Find corresponding output event files
        output_dir = Path("output")
        span_output_files = list(output_dir.glob("**/*Span*_events.tsv"))
        
        if not span_output_files:
            pytest.skip("No span output event files found in output directory")
        
        # Test each file pair
        for input_file in span_input_files:
            # Find corresponding output file
            subject = input_file.stem.split('_')[0]  # e.g., "sub-s4"
            session = input_file.stem.split('_')[1]  # e.g., "ses-1" 
            run = input_file.stem.split('_')[2]      # e.g., "run-1"
            
            matching_output = None
            for output_file in span_output_files:
                if subject in output_file.name and session in output_file.name and run in output_file.name:
                    matching_output = output_file
                    break
            
            if not matching_output:
                continue
                
            # Read the files
            input_df = pd.read_csv(input_file)
            output_df = pd.read_csv(matching_output, sep='\t')
            
            # Parse correct_cell_order and valid_responses_timestamps from input
            for idx, row in input_df.iterrows():
                correct_cell_order_str = row.get('correct_cell_order', '')
                valid_responses_timestamps_str = row.get('valid_responses_timestamps', '')
                
                # Parse the lists
                def parse_list(list_str):
                    if pd.isna(list_str) or list_str == '' or list_str == 'n/a':
                        return []
                    try:
                        return ast.literal_eval(list_str) if isinstance(list_str, str) else []
                    except:
                        return []
                
                correct_cell_order = parse_list(correct_cell_order_str)
                valid_responses_timestamps = parse_list(valid_responses_timestamps_str)
                
                # Only test if both lists are non-empty
                if correct_cell_order and valid_responses_timestamps:
                    # Find corresponding rows in output (by trial_id or similar identifier)
                    trial_id = row.get('trial_id', f'trial_{idx}')
                    output_rows = output_df[output_df.get('trial_id', '').str.contains(str(trial_id), na=False)]
                    
                    if len(output_rows) == 0:
                        # Try alternative matching strategies
                        output_rows = output_df[output_df.index == idx]
                    
                    # Check that each correct_cell_order item has corresponding valid_responses_timestamp
                    for i, cell_order_item in enumerate(correct_cell_order):
                        # Find row with this correct_cell_order item
                        cell_rows = output_rows[output_rows.get('correct_cell_order', '') == str(cell_order_item)]
                        
                        if len(cell_rows) == 0:
                            # Try finding by index if direct matching doesn't work
                            if i < len(output_rows):
                                cell_rows = output_rows.iloc[[i]]
                        
                        assert len(cell_rows) > 0, f"Could not find output row for correct_cell_order {cell_order_item} in trial {trial_id}"
                        
                        # Get the response_time for this row
                        cell_row = cell_rows.iloc[0]
                        response_time = cell_row.get('response_time', cell_row.get('valid_responses_timestamps', ''))
                        
                        if i < len(valid_responses_timestamps):
                            # Should have corresponding valid_responses timestamp
                            expected_time = str(valid_responses_timestamps[i])
                            assert response_time == expected_time, f"For correct_cell_order {cell_order_item}, expected response_time {expected_time} but got {response_time}"
                        else:
                            # Should be n/a since valid_responses_timestamps list is shorter
                            assert response_time == 'n/a' or response_time == '', f"For correct_cell_order {cell_order_item}, expected response_time to be n/a but got {response_time}"

    def test_span_data_processing_integration(self):
        """
        Test that span data processing is integrated into the main processor.
        
        This tests the complete flow from raw data to processed event data.
        """
        from rdoc_events_processor.data_processing.span_manipulators import process_span_data_for_events
        
        # Test data with cell_order_through_grid list column
        input_data = pd.DataFrame({
            'onset': [1.0, 2.0],
            'duration': [2.5, 2.5],
            'trial_id': ['trial1', 'trial2'],
            'cell_order_through_grid': ['[1, 5, 9]', '[2, 6]'],
            'other_column': ['A', 'B']
        })
        
        # Process for opSpan
        result = process_span_data_for_events(input_data, 'opSpan')
        
        # Should have expanded rows (3 + 2 = 5 rows)
        assert len(result) == 5
        
        # Check that cell_order_through_grid was expanded
        expected_cell_order = ['1', '5', '9', '2', '6']
        assert result['cell_order_through_grid'].tolist() == expected_cell_order
        
        # Check that other columns were duplicated correctly
        expected_other = ['A', 'A', 'A', 'B', 'B']
        assert result['other_column'].tolist() == expected_other


